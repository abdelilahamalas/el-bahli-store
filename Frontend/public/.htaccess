# ==============================================================================
# EL BAHLI STORE — FRONTEND .HTACCESS (HOSTINGER PREMIUM / LITESPEED / APACHE)
# ==============================================================================
# Emplacement sur Hostinger : /home/u123456789/domains/DOMAINE-MA/public_html/.htaccess
# ==============================================================================

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. Adresse unique : https://elbahlistore.com (retire www et force HTTPS)
RewriteCond % { HTTP_HOST } ^www\. [NC]
RewriteRule ^ https://elbahlistore.com% { REQUEST_URI } [L, R=301]
RewriteCond % { HTTPS } !=on
RewriteCond % { HTTP:X-Forwarded-Proto } !https
RewriteRule ^ https://elbahlistore.com% { REQUEST_URI } [L, R=301]

# 2. Bloquer l'accès aux fichiers cachés (.git, .env, etc.)
RewriteRule "(^|/)\.(?!well-known)" - [F]

# 3. Ne pas rediriger si le fichier ou dossier physique existe réellement
RewriteCond % { REQUEST_FILENAME } -f [OR]
RewriteCond % { REQUEST_FILENAME } -d
RewriteRule ^ - [L]

# 4. Fallback React Router SPA : toutes les autres routes vers index.html
RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# EN-TÊTES DE SÉCURITÉ HTTP
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set X-XSS-Protection "1; mode=block"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

# Ne jamais mettre en cache index.html pour permettre les mises à jour instantanées
<Files "index.html">
Header set Cache-Control "no-cache, no-store, must-revalidate"
Header set Pragma "no-cache"
Header set Expires 0
</Files>

# Cache long pour les assets hashés par Vite
<FilesMatch "\.(js|css|webp|png|jpe?g|svg|woff2?)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# COMPRESSION GZIP / BROTLI (LITESPEED / APACHE)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# EXPIRATION DU CACHE
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 month"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Désactiver le listage des dossiers
Options -Indexes
