# ==============================================================================
# EL BAHLI STORE — FRONTEND .HTACCESS (HOSTINGER PREMIUM / LITESPEED / APACHE)
# ==============================================================================
# Emplacement cible sur Hostinger : /home/u123456789/domains/DOMAINE-MA/public_html/.htaccess
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Forcer la redirection HTTP vers HTTPS (certificat SSL Let's Encrypt hPanel)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Bloquer l'accès aux fichiers cachés (.git, .env, etc.)
    RewriteRule "(^|/)\.(?!well-known)" - [F]

    # 3. Ne pas rediriger si le fichier ou dossier physique existe réellement
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. Fallback React Router SPA : router toutes les URLs virtuelles vers index.html
    # Permet le rechargement direct de /products, /categories/..., /cart, /checkout, /zakaria/admin/login
    RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# EN-TÊTES DE SÉCURITÉ HTTP (LITESPEED / APACHE)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Ne jamais mettre en cache le fichier index.html (mises à jour immédiates)
    <Files "index.html">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </Files>

    # Cache long et immuable pour les assets hashés par Vite (JS, CSS, images, polices)
    <FilesMatch "\.(js|css|webp|png|jpe?g|svg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# COMPRESSION GZIP / BROTLI (LITESPEED / APACHE MOD_DEFLATE)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# EXPIRATION DU CACHE NAVIGATEUR (MOD_EXPIRES)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Désactiver le listage des dossiers
Options -Indexes
